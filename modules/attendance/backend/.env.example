# Copy to api/.env for local dev. Read only when APP_ENV is not "production".
APP_ENV=development
DATABASE_URL=postgres://attendance:attendance@localhost:5433/attendance?sslmode=disable
PORT=8080
# People sign in to NxtOne only: it signs every request with an identity token. This must equal
# ATTENDANCE_JWT_SECRET in platform/web. Leave empty locally (the docker-compose.yml value is used);
# production needs 32+ random characters.
IDENTITY_JWT_SECRET=
