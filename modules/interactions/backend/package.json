{
  "name": "interactions-api",
  "version": "0.1.0",
  "private": true,
  "description": "Interactions (Instructor Evaluation) service: interaction logs, student progress, instructors, level analytics",
  "author": "Rajveer Sharma",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "migrate": "node --env-file-if-exists=.env dist/migrate.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "2.1.6",
    "hono": "4.13.16",
    "jose": "6.2.17",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "typescript": "5.9.3"
  }
}
