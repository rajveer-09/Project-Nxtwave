# Copy to .env for `npm run dev` (git-ignored). Never commit real values.

# interactions_svc role on the combined database. Its search_path (logs, core, extensions) puts
# this service's tables in the logs schema (platform/db/setup/service_roles.sql).
DATABASE_URL=postgresql://interactions_svc:PASSWORD@POOLER_HOST/neondb?sslmode=require

# Same value as INTERACTIONS_JWT_SECRET in platform/web. 32+ random characters.
IDENTITY_JWT_SECRET=

PORT=8090
# Apply db/schema.sql at start (idempotent, safe on every start)
MIGRATE_ON_START=true
# DB_POOL_MAX=5
