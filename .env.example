# Copy to .env (git-ignored). Never commit real values.

# --- Combined database (Neon) ---
# Owner connection: only for migrations and db/setup scripts
DATABASE_URL_OWNER=postgresql://OWNER:PASSWORD@HOST/neondb?sslmode=require
# Service connections (created by db/setup/service_roles.sql)
WEB_DATABASE_URL=postgresql://web_svc:PASSWORD@POOLER_HOST/neondb?sslmode=require

# --- Source databases (read-only use by db/migration scripts) ---
SRC_ATTENDANCE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
SRC_LOGS_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
SRC_CONTEST_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
