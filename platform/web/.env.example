# Copy to .env.local (git-ignored). Never commit real values.

# --- Database (enables real sign-in). Leave unset for the development role picker. ---
# Use the pooled connection string of the web_svc role (platform/db/setup/service_roles.sql).
WEB_DATABASE_URL=

# --- Google workspace sign-in (optional) ---
APP_BASE_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ALLOWED_DOMAIN=nxtwave.co.in

# --- Backend services (the /api/attendance, /api/contest and /api/logs proxies) ---
# Each secret is 32+ random characters and must match the service's IDENTITY_JWT_SECRET.
ATTENDANCE_API_ORIGIN=
ATTENDANCE_JWT_SECRET=
CONTEST_API_ORIGIN=
CONTEST_JWT_SECRET=
INTERACTIONS_API_ORIGIN=
INTERACTIONS_JWT_SECRET=

# Only for a private review deployment without a database. Never on a public site.
# ALLOW_DEV_SESSION=true
